# Required in production. Signs the session cookie (placeholder auth).
SESSION_SECRET=change-me-to-a-long-random-string

# Bearer token accepted by POST /api/mcp (dev default: kitchi-dev-token; disabled in production if unset).
KITCHI_MCP_TOKEN=

# AI provider for Ask Kitchi. "deterministic" works offline; add providers in src/server/ai/index.ts.
KITCHI_AI_PROVIDER=deterministic

# PostgreSQL (used once the Prisma repositories replace the in-memory ones).
DATABASE_URL=postgresql://kitchi:kitchi@localhost:5432/kitchi
